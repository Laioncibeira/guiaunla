{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "recursos",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|webp|png|webmanifest|woff2)", "!/ELECCIONES/**"]
      }
    },
    {
      "name": "paginas",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/index.html"]
      }
    },
    {
      "name": "elecciones",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/ELECCIONES/**"]
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/admin", "!/admin/**", "!/ELECCIONES", "!/ELECCIONES/**"],
  "dataGroups": [
    {
      "name": "elecciones",
      "urls": ["/ELECCIONES"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "30d",
        "timeout": "5s"
      }
    }
  ]
}
